# =========================================================
# TEMPLATE KONFIGURASI ENVIRONMENT
# Salin file ini menjadi .env.local dan isi dengan kredensial proyek Anda.
# JANGAN PERNAH mengunggah file .env.local ke repositori publik!
# =========================================================

# URL & Kunci Akses Publik Supabase (Dapatkan dari Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL="https://your-supabase-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"

# Token Apify untuk Instagram Scraper (Dapatkan dari https://console.apify.com)
# Opsional: Jika dikosongkan, sistem akan berjalan dalam mode Dynamic Mock Scraper untuk keperluan dev lokal.
APIFY_TOKEN="your-apify-api-token"
