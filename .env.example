# =========================================================
# TEMPLATE KONFIGURASI ENVIRONMENT
# Salin file ini menjadi .env.local dan isi dengan kredensial proyek Anda.
# JANGAN PERNAH mengunggah file .env.local ke repositori publik!
# =========================================================

# URL & Kunci Akses Publik Supabase (Dapatkan dari Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL="https://your-supabase-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"

# ---------------------------------------------------------
# REMEDIASI LEGAL — lihat docs/REMEDIASI_LEGAL_IRS.md
# ---------------------------------------------------------

# Scraping Instagram lewat Apify. BIARKAN MATI.
# Praktik ini melanggar Ketentuan Layanan Meta dan mengambil data pribadi tanpa
# dasar pemrosesan yang sah menurut UU 27/2022. Penggantinya adalah Instagram
# Graph API dengan OAuth (Fase 3). Selama flag ini mati, Verifikasi Otomatis
# tidak tersedia dan karyawan menggunakan Verifikasi Manual — poinnya sama.
ENABLE_APIFY_SCRAPING="false"

# Token Apify (Dapatkan dari https://console.apify.com)
# Hanya terpakai bila ENABLE_APIFY_SCRAPING bernilai true.
APIFY_TOKEN=""

# Mock scraper untuk pengembangan lokal. Menghasilkan metrik KARANGAN.
# Tidak pernah aktif ketika NODE_ENV=production, berapa pun nilainya.
ENABLE_MOCK_SCRAPER="false"

# ---------------------------------------------------------

# Google Gemini API Key untuk Verifikasi Visual AI & Rekomendasi Analitik Konten
# Dapatkan dari Google AI Studio (https://aistudio.google.com/)
# Bila dikosongkan, verifikasi AI dilewati dan postingan dialihkan ke antrean
# review admin — tidak lagi disetujui otomatis tanpa pemeriksaan.
#
# CATATAN KEPATUHAN: endpoint ini mengirim gambar dan caption karyawan ke server
# Google di luar Indonesia. Perlu keputusan Legal soal dasar transfer lintas
# negara (UU 27/2022 Pasal 56) atau pemindahan ke Vertex AI region Jakarta.
GEMINI_API_KEY=""
